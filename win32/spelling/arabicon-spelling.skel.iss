AppName=ARABICON Spelling Dictionaries
AppVerName=ARABICON Spelling Dictionaries r1
AppVersion=1.0
VersionInfoVersion=1.0
OutputBaseFilename=ARABICON Spelling Dictionaries r1
AppPublisher=ARABICON
AppPublisherURL=http://www.arabicon.org/
AppCopyright=Copyright (C) 1998-2010 Peter Zelezny
AppSupportURL=https://github.com/arabicon/arabicon/issues
AppUpdatesURL=http://www.arabicon.org/home/downloads
DefaultDirName={localappdata}\enchant
DefaultGroupName=ARABICON
DisableProgramGroupPage=yes
DisableDirPage=yes
SolidCompression=yes
Compression=lzma2/ultra64
SourceDir=.
OutputDir=.
FlatComponentsList=no
PrivilegesRequired=lowest
ShowComponentSizes=no
CreateUninstallRegKey=no
Uninstallable=no
DirExistsWarning=no
ArchitecturesAllowed=x86 x64

[Files]
Source: "myspell\*"; DestDir: "{app}\myspell"; Flags: createallsubdirs recursesubdirs

[Messages]
BeveledLabel= ARABICON
